{
  "name": "discord-cv2-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord em TypeScript para criar painéis Components V2, dropdowns e animações.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joao9090usuary/discord-cv2-studio.git"
  },
  "bugs": {
    "url": "https://github.com/joao9090usuary/discord-cv2-studio/issues"
  },
  "homepage": "https://github.com/joao9090usuary/discord-cv2-studio#readme",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/tests/request-parser.test.js dist/tests/panel-renderer.test.js",
    "commands": "tsx src/deploy-commands.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
